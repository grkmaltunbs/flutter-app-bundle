rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One user, one tool. Everything under the relay belongs to that uid;
    // nobody else — including another signed-in account — reads or writes.
    // The uid is the Email/Password user created in the console on
    // 2026-08-28. Change it here if the account is ever recreated.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'I8XBZsWr9sScTrDAiOK2LSZ5qFZ2';
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
